# Existing print-service configuration
PRINT_WEB_TOKEN=replace-with-a-random-secret-at-least-32-characters
CUPS_QUEUE=munbyn

# Saved sticker designs; mount a persistent host directory at /data in Docker Compose.
STICKER_TEMPLATE_FILE=/data/sticker-templates.json

# Optional Home Assistant printer power control.
# Leave all three HA_* values blank to keep this feature disabled.
HA_BASE_URL=
HA_WAKE_WEBHOOK_ID=
HA_SLEEP_WEBHOOK_ID=

# Defaults; adjust after observing the printer's startup and desired off delay.
PRINTER_STARTUP_DELAY_SECONDS=15
PRINTER_IDLE_TIMEOUT_SECONDS=120
PRINTER_STATUS_POLL_SECONDS=5
HA_WEBHOOK_TIMEOUT_SECONDS=10
